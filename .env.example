# Local example only. Run python3 tools/init_local_env.py to generate .env.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECRET_KEY=
DB_NAME=accounting_platform
DB_USER=accounting_platform
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Production uses injected environment or mounted *_FILE secrets, never this file.
# DJANGO_SETTINGS_MODULE=core.settings.production
# DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key
# DB_PASSWORD_FILE=/run/secrets/db_password
# DJANGO_ALLOWED_HOSTS=your-owned-hostname.duckdns.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-owned-hostname.duckdns.org
# DJANGO_TRUST_PROXY_HEADERS=false
